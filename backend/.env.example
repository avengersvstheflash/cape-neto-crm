# Cape Neto CRM — Backend Environment Configuration Example
# Copy this file to .env and configure values before starting the application.

# Database URL
# Local SQLite default:
DATABASE_URL=sqlite:///./crm.db
# Render PostgreSQL example:
# DATABASE_URL=postgresql://user:password@dpg-xxxxx.render.com/capeneto_crm

# JWT Authentication
JWT_SECRET_KEY=replace-with-secure-32-character-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
APP_NAME=Cape Neto CRM
DEBUG=false

# Allowed Frontend URL for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app
